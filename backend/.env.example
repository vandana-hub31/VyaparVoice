# =============================================================================
# VyaparVoice — Backend Environment Configuration
# Great Indian AI Internship Challenge 2026 — Gnani.ai
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit your .env file with real credentials to version control.
# =============================================================================

# PostgreSQL Database
DATABASE_URL=postgresql+psycopg://postgres@localhost:5433/vyaparvoice
TEST_DATABASE_URL=postgresql+psycopg://postgres@localhost:5433/vyaparvoice_test

# JWT Authentication (use a strong random secret in production)
SECRET_KEY=your_strong_random_jwt_secret_here_change_this
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS — add your frontend URL here
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# =============================================================================
# Gnani AI Competition APIs — REQUIRED FOR VOICE FEATURES
# =============================================================================
# 1. Log in to https://app.gnani.ai with your competition account
# 2. Go to API Keys section and copy your API key
# 3. Paste it below (the key usually starts with "gn-" or similar)
# =============================================================================
GNANI_API_KEY=your_gnani_competition_api_key_here

# Gnani API Endpoints (documented at https://docs.gnani.ai)
GNANI_API_BASE_URL=https://api.vachana.ai
GNANI_STT_ENDPOINT=https://api.vachana.ai/stt/v3
GNANI_TTS_ENDPOINT=https://api.vachana.ai/api/v1/tts/inference

# Gnani Model Versions
GNANI_STT_MODEL=prisma-v3.0
GNANI_TTS_MODEL=timbre-v3.0

# =============================================================================
# Application Configuration
# =============================================================================
DEMO_MODE=true
APP_NAME=VyaparVoice
DEBUG=true
